<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Pyvis" Manufacturer="Pyvis" Version="$(var.PackageVersion)" Language="2052" Codepage="936"
           UpgradeCode="2E404B15-0C22-44F4-8E62-609D079A784E" Scope="perUserOrMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes" IgnoreLanguage="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="!(loc.PyvisNewerVersion)" />
    <InstallUISequence>
      <!-- The first dialog returns after the wizard has set ALLUSERS. -->
      <FindRelatedProducts Sequence="1260" />
      <LaunchConditions Sequence="1270" />
      <MigrateFeatureStates Sequence="1280" />
    </InstallUISequence>
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="Pyvis.exe" SourceFile="!(bindpath.payload)\pyvis_editor.exe" />
    <Property Id="ARPPRODUCTICON" Value="Pyvis.exe" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PYVISDESKTOP" Secure="yes" />
    <UIRef Id="PyvisSetup" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Pyvis">
        <Component Id="PyvisExecutable" Guid="308F0F8E-751A-4A3B-99BC-5861F9C40E91">
          <File Id="PyvisExe" Source="!(bindpath.payload)\pyvis_editor.exe" KeyPath="yes">
            <Shortcut Id="PyvisStartMenu" Name="Pyvis" Directory="ProgramMenuFolder"
                      WorkingDirectory="INSTALLFOLDER" Icon="Pyvis.exe" Advertise="yes" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="PyvisDesktopShortcut" Guid="5BA1BD87-D4D5-42F5-A980-34DD4375A447"
                 Condition='PYVISDESKTOP = "1"'>
        <Shortcut Id="PyvisDesktop" Name="Pyvis" Target="[#PyvisExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\Pyvis" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Pyvis" Title="Pyvis" Level="1">
      <ComponentGroupRef Id="PyvisFiles" />
      <ComponentRef Id="PyvisExecutable" />
      <ComponentRef Id="PyvisDesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PyvisFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.payload)\**">
        <Exclude Files="!(bindpath.payload)\pyvis_editor.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
